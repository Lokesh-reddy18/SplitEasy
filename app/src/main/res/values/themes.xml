<resources>
    <!-- Compose draws the UI; this theme only covers the window before Compose starts. -->
    <style name="Theme.SplitEasy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Shown at launch while the app checks whether someone is signed in. -->
    <style name="Theme.SplitEasy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SplitEasy</item>
    </style>
</resources>
